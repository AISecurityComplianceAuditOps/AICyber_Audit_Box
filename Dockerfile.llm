# LLM server image -- extends llama.cpp's official pre-built server image
# (no build-from-source, per the earlier decision) and bakes in every model
# weight this app uses (two completion models + embedding), so this single image needs
# nothing mounted or downloaded separately. One image, two docker-compose
# services (LLM_MODE=completion / LLM_MODE=embedding) -- see
# docker/llm-entrypoint.sh.
#
# NOTE: verify the base image tag against the current llama.cpp GHCR release
# before first build (ghcr.io/ggml-org/llama.cpp:server) -- tags occasionally
# change upstream and this wasn't verified against a live registry pull.

FROM ghcr.io/ggml-org/llama.cpp:server

# One completion model ships: the 12B. The E4B was dropped deliberately -- it
# cost 5.4GB in every bundle to serve as a fallback for a machine too small for
# the 12B, and this build targets a site sized for the 12B. A site that is NOT
# sized for it has no working configuration in this image, which is why
# llm-entrypoint.sh now says so outright instead of suggesting LLM_MODEL=e4b.
#
# An operator who needs different weights can still mount them and point
# LLM_MODEL at the absolute path; only the baked-in shortcut is gone.
COPY gemma-4-12B-it-Q8_0.gguf /models/gemma-4-12B-it-Q8_0.gguf
COPY nomic-embed-text-v1.5.f16.gguf /models/nomic-embed-text-v1.5.f16.gguf
COPY docker/llm-entrypoint.sh /llm-entrypoint.sh
RUN chmod +x /llm-entrypoint.sh

EXPOSE 11434 11435

# The base image's own HEALTHCHECK hardcodes port 8080, which doesn't match
# either port this app actually uses (11434 completion / 11435 embedding) --
# overriding with a check that picks the right port for whichever LLM_MODE
# this container instance is running. start_period is generous (10 min)
# because loading the ~5GB completion model on CPU-only hardware can
# genuinely take several minutes; premature "unhealthy" flapping during that
# window would be a false alarm, not a real problem.
HEALTHCHECK --interval=5s --timeout=3s --start-period=600s --retries=30 \
    CMD sh -c 'if [ "$LLM_MODE" = "embedding" ]; then curl -f http://localhost:11435/health; else curl -f http://localhost:11434/health; fi'

ENTRYPOINT ["/llm-entrypoint.sh"]
